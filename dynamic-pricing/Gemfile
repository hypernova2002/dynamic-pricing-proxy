source "https://rubygems.org"

ruby "3.2.6"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 7.1.5", ">= 7.1.5.2"

# Use sqlite3 as the database for Active Record
gem "sqlite3", ">= 1.4"

# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Use Kredis to get higher-level data types in Redis [https://github.com/rails/kredis]
# gem "kredis"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# HTTP client for external API call
gem "httparty"

# json 3 rejects the quirks_mode option that Rails 7.1 passes to JSON.generate.
gem "json", "< 3"

# JSON serialization for API responses
gem "alba", "~> 4.0"

# Request models with JSON Schema generation
gem "json_model_rb", "~> 0.1.30", require: "json_model"

# Shared cache for rates, because the API quota is per token rather than per process
gem "redis", "~> 6.0"

# One structured log line per request
gem "lograge", "~> 0.15.1"

# Request throttling
gem "rack-attack", "~> 6.8"

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ]

  gem "rspec-rails", "~> 7.1"

  gem "rubocop-rails-omakase", "~> 1.1", require: false

  # Generates OpenAPI docs from request specs
  gem "openapi-ruby", "~> 5.0"
end

group :development do
  # Speed up commands on slow machines / big apps [https://github.com/rails/spring]
  # gem "spring"

  # Live reloading for development
  gem "listen", "~> 3.3"
end

group :test do
  gem "webmock", "~> 3.34"
end
